# Copiar a `.env` y rellenar con valores reales. `.env` está ignorado por git.

# Cadena de conexión a PostgreSQL (coincide con docker-compose.yml).
DATABASE_URL=postgresql+psycopg://helpcenter:helpcenter@localhost:5432/helpcenter

# Secreto para firmar los JWT. Generar uno propio, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRE_MINUTES=60

# Administrador inicial que crea el seed. Cambiar la contraseña antes de sembrar.
ADMIN_EMAIL=admin@centro-ayuda.local
ADMIN_PASSWORD=cambia-esta-contrasena
